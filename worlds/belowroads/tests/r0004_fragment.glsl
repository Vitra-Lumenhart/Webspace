#version 300 es
precision highp float;in vec3 w,n,col;in vec4 lightCoord;out vec4 outColor;uniform vec3 uEye,uDir,uLampPos;uniform float uLamp,uTime,uMode,uInspect,uSixth,uSeed,uTilt,uBeds,uFracture,uCalcite;uniform vec3 uMark;uniform sampler2D uStone,uNormal,uGravel,uShadow;
float hash(vec3 p){p=fract(p*.3183099+vec3(.11,.17,.23));p*=17.;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}
float noise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);}
float fb(vec3 p){return noise(p)*.54+noise(p*2.03)*.27+noise(p*4.11)*.13+noise(p*8.17)*.06;}
vec3 tri(sampler2D t,vec3 p,vec3 N){vec3 k=pow(abs(N),vec3(4));k/=max(.0001,k.x+k.y+k.z);return texture(t,p.yz).rgb*k.x+texture(t,p.xz).rgb*k.y+texture(t,p.xy).rgb*k.z;}
// Jittered 3D solid cells: bounded eight-corner approximation, not a grain simulation.
vec3 grainField(vec3 p){vec3 i=floor(p),f=fract(p);float a=100.,b=100.,id=0.;for(int z=0;z<2;z++)for(int y=0;y<2;y++)for(int x=0;x<2;x++){vec3 c=vec3(float(x),float(y),float(z)),q=i+c;vec3 j=vec3(hash(q),hash(q+17.3),hash(q+29.1))-.5;vec3 r=c+j*.74-f;float d=dot(r,r);if(d<a){b=a;a=d;id=hash(q+41.7);}else b=min(b,d);}return vec3(id,sqrt(a),sqrt(b)-sqrt(a));}
float lineSeg(vec2 p,vec2 a,vec2 b){vec2 d=b-a;return length(p-a-d*clamp(dot(p-a,d)/dot(d,d),0.,1.));}
// Receiver-side 3x3 PCF for the physical lamp; actual cave and formation triangles cast shadows.
float visibility(vec3 N,vec3 L){if(lightCoord.w<=0.)return 1.;vec3 q=lightCoord.xyz/lightCoord.w*.5+.5;if(q.x<.002||q.x>.998||q.y<.002||q.y>.998||q.z>1.||q.z<0.)return 1.;float bias=.0035+.006*(1.-max(dot(N,L),0.));float sum=0.;vec2 texel=1./vec2(textureSize(uShadow,0));for(int i=-1;i<=1;i++)for(int j=-1;j<=1;j++)sum+=step(q.z-bias,texture(uShadow,q.xy+vec2(float(i),float(j))*texel).r);return sum/9.;}
vec3 bump(vec3 N,float h){vec3 dx=dFdx(w),dy=dFdy(w);vec3 r1=cross(dy,N),r2=cross(N,dx);float det=dot(dx,r1);return normalize(abs(det)*N-sign(det)*(dFdx(h)*r1+dFdy(h)*r2)+N*1e-8);}
void main(){vec3 N=normalize(n),geomN=N,V=normalize(uEye-w),base=col;float rough=.57,wet=0.,ao=1.;float rock=step(.5,uMode)*(1.-step(1.5,uMode));float water=step(1.5,uMode);float dist=length(uEye-w);
if(rock>.5){vec3 p=w+vec3(uSeed*.013);float f=fb(p*.9),grain=fb(p*9.7),coarse=fb(p*2.7);float B=w.y+uTilt*w.x-.065*w.z+.19*sin(w.x*.53-w.z*.24)+.11*sin(-w.z*.61)+.24*sin(w.y*.72-w.z*.13)+.075*sin(w.x*3.7-w.z*2.1)*sin(-w.z*1.7-w.x*2.2);float ph=fract(B/1.12);float hard=exp(-pow((ph-.27)/.095,2.)),seam=exp(-pow((ph-.72)/.045,2.));float cleft=pow(abs(sin(w.x*2.7-w.z*.92+.28*w.y)),18.)*pow(abs(sin(w.y*1.23+w.z*.31)),4.);float floorMask=smoothstep(.68,.94,N.y);vec3 tex=tri(uStone,p*1.18,N);vec3 grit=tri(uGravel,p*1.8,N);
float dry=clamp(.5+.36*sin(w.x*.71-w.z*.29)+.16*sin(-w.z*1.1),0.,1.);float deposit=step(.78,col.r);float calcite=max(deposit,smoothstep(.56,.80,dry)*smoothstep(.40,.82,fb(vec3(p.x*1.4,p.y*.25,p.z*1.4)))*uCalcite);
vec3 stone=mix(vec3(.15,.13,.105),vec3(.44,.39,.30),smoothstep(.18,.82,f));stone*=mix(.74,1.25,coarse)*mix(.83,1.17,grain);stone=mix(stone,tex*stone*2.15,.48);stone=mix(stone,vec3(.16,.185,.19)*( .74+.38*coarse),hard*.72*uBeds);stone=mix(stone,vec3(.07,.075,.069),seam*.8*uBeds);stone*=1.-.31*cleft*uFracture;stone=mix(stone,vec3(.54,.46,.33)*(.77+.35*grain),calcite*.73);stone=mix(stone,grit*vec3(.34,.29,.22),floorMask*.70);
// Multi-scale grain contrast fades out before it aliases at distance.
 float nearDetail=1.-smoothstep(3.,9.,dist);vec3 g=grainField(p*vec3(11.,17.,11.)+vec3(f*1.4));float nodule=smoothstep(.77,.86,fb(p*vec3(3.3,5.2,3.3)));float boundary=1.-smoothstep(.015,.065,g.z);float sty=1.-smoothstep(.012,.035,abs(ph-.72));stone*=1.+nearDetail*((g.x-.5)*.14-boundary*.035)*(1.-deposit);stone=mix(stone,vec3(.10,.13,.135)*(.7+.5*g.x),nodule*.65*(1.-deposit));stone*=1.-sty*.31*(1.-deposit);stone=mix(stone,vec3(.60,.46,.28)*(.80+.26*sin(w.y*9.+coarse*4.)+.15*grain),deposit*.85);
 wet=clamp(dry*.83+calcite*.18,0.,1.)*mix(1.,.55,floorMask);base=stone*(1.-wet*.40);rough=mix(mix(.91,.19,wet),.29,deposit);vec3 q=tri(uNormal,p*1.4,N)*2.-1.;float relief=.080*coarse+.025*grain-.044*seam*uBeds-.040*cleft*uFracture+.022*q.x+nearDetail*(g.y*.003)*(1.-deposit);N=bump(N,relief);ao=clamp(.42+.69*coarse-.18*cleft,.28,1.);
 vec2 m=vec2(w.z-uMark.z,w.y-uMark.y);float area=step(uMark.x-.60,w.x)*step(abs(m.x),.75)*step(abs(m.y),.56);if(area>.5){float d=10.;for(int i=0;i<6;i++){if(i==5&&uSixth<.5)continue;float k=float(i);float x=-.39+k*.145;float wob=.018*sin(m.y*13.+k*2.3);d=min(d,lineSeg(m+vec2(wob,0),vec2(x-.018,-.23+.023*sin(k*4.)),vec2(x+.025,.21+.033*cos(k*3.))));}float scratch=1.-smoothstep(.012,.024,d);float lip=1.-smoothstep(.023,.036,d);base=mix(base,base*1.18+vec3(.025),lip*.55);base=mix(base,vec3(.035,.029,.020),scratch*.82);rough=mix(rough,.8,scratch);}}
if(water>.5){float ripple=sin(w.x*19.+w.z*13.+uTime*1.7)*sin(w.z*24.-uTime*1.4);N=normalize(vec3(ripple*.038,1.,cos(w.x*15.+w.z*18.+uTime*1.2)*.045));base=vec3(.046,.047,.032);rough=.12;wet=1.;}
vec3 L=uLampPos-w;float ld=max(.18,length(L));L/=ld;float cone=smoothstep(.38,.86,dot(-L,uDir));float lam=max(dot(N,L),0.);vec3 H=normalize(L+V);float spec=pow(max(dot(N,H),0.),mix(120.,9.,rough));float flick=1.+.018*sin(uTime*8.7)+.012*sin(uTime*13.2);float lamp=uLamp*flick*(.075+.925*cone)/(1.+.32*ld+.105*ld*ld);float shadow=uInspect>.5?1.:mix(.035,1.,visibility(geomN,L));vec3 lit=base*lamp*(lam*4.4*shadow+.045)*vec3(1.26,.94,.58)*ao;lit+=vec3(1.,.76,.43)*spec*lamp*shadow*(.10+wet*.85);if(water>.5){float fres=pow(1.-max(0.,dot(N,V)),5.);lit+=vec3(.27,.19,.10)*lamp*fres*.42;}
// No constant ambient. Cool entrance daylight is extinguished through the first bend.
vec3 dl=normalize(vec3(-.3,2.1,1.8)-w);float entrance=exp(-max(0.,-w.z)*.48)*(1.-smoothstep(5.,11.,-w.z));float sky=entrance*max(0.,dot(N,dl));lit+=base*vec3(.63,.78,.93)*sky*2.0*ao;lit+=base*vec3(.25,.34,.40)*entrance*.18;
if(uInspect>.5){float fill=.50+.65*max(0.,dot(N,normalize(vec3(-.3,.8,.55))));lit=base*fill*vec3(1.12,1.02,.83)+spec*.12;}
// Absorption without emissive fog: unlit rock really goes black.
lit*=exp(-dist*.018);lit=lit/(lit+vec3(.82));lit=pow(max(lit,vec3(0)),vec3(.4545));outColor=vec4(lit,1.);}